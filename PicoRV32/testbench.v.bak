`timescale 1ns / 1ps

module testbench;
    // --- Khai bao cac tin hieu de ket noi voi DUT (Design Under Test) ---
    reg clk;            // Xung nhip he thong
    reg resetn;         // Tin hieu reset (tich cuc muc thap)
    wire trap_0;        // Tin hieu bao loi tu Core 0
    wire trap_1;        // Tin hieu bao loi tu Core 1

    // --- Khoi tao module dual_core (Lap rap he thong vao moi truong test) ---
    dual_core dut (
        .clk(clk),
        .resetn(resetn),
        .trap_0(trap_0),
        .trap_1(trap_1)
    );

    // --- Tao xung nhip (Clock Generation) ---
    // Chu ky 10ns tuong duong tan so 100MHz
    initial begin
        clk = 0;
        forever #5 clk = ~clk; // Cu moi 5ns thi dao chieu clk mot lan
    end

    // --- Kich ban mo phong (Stimulus) ---
    initial begin
        // Mac dinh luc moi bat dau
        resetn = 0;
        
        // Giu Reset trong 100ns de cac thanh ghi ben trong duoc xoa sach
        #100;
        resetn = 1; // Bat dau cho he thong chay
        
        $display("--- He thong Dual-Core bat dau thuc thi lenh ---");

        // Cho he thong chay trong mot khoang thoi gian du dai
        // Ban co the tang con so nay len neu chuong trinh C cua ban dai hon
        #50000;
        
        // Kiem tra xem co loi xay ra trong qua trinh chay khong
        if (trap_0) $display("!!! CORE 0: Gap loi nghiem trong (Trap) !!!");
        if (trap_1) $display("!!! CORE 1: Gap loi nghiem trong (Trap) !!!");
        
        $display("--- Ket thuc thoi gian mo phong ---");
        $finish; // Dung mo phong
    end

    // --- Luu tru du lieu Waveform (De xem dang song tren ModelSim) ---
    initial begin
        $dumpfile("testbench.vcd"); // Ten file waveform
        $dumpvars(0, testbench);    // Luu tat ca cac bien trong testbench
    end

endmodule