module dual_port_ram #(
    parameter ADDR_WIDTH = 12, // ?? r?ng ??a ch?: 2^12 = 4096 t? (t??ng ???ng 16KB)
    parameter INIT_FILE = ""   // Tên file .hex ?? n?p ch??ng trình vào RAM khi kh?i ??ng
)(
    input clk,
    // --- Giao ti?p C?ng A (Dành cho Core 0) ---
    input [ADDR_WIDTH-1:0] addr_a, // ??a ch? truy c?p t? Core 0
    input [31:0]           din_a,  // D? li?u ghi t? Core 0
    input [3:0]            we_a,   // Byte-enable (m?t n? ghi): cho phép ghi t?ng byte trong 32-bit
    output reg [31:0]      dout_a, // D? li?u Core 0 ??c ra
    
    // --- Giao ti?p C?ng B (Dành cho Core 1) ---
    input [ADDR_WIDTH-1:0] addr_b, // ??a ch? truy c?p t? Core 1
    input [31:0]           din_b,  // D? li?u ghi t? Core 1
    input [3:0]            we_b,   // Byte-enable cho Core 1
    output reg [31:0]      dout_b  // D? li?u Core 1 ??c ra
);
    // Khai báo m?ng RAM l?u tr? (32-bit cho m?i ??a ch?)
    reg [31:0] ram [0:(2**ADDR_WIDTH)-1];

    // Kh?i t?o n?i dung RAM (n?p file ch??ng trình .hex ?? ch?y mô ph?ng)
    initial begin
        if (INIT_FILE != "") $readmemh(INIT_FILE, ram);
    end

    // Logic x? lý cho C?ng A (M?i l?n xung nh?p lên)
    always @(posedge clk) begin
        // Ki?m tra t?ng bit trong we_a ?? ghi ?úng byte t??ng ?ng (byte-masking)
        if (we_a[0]) ram[addr_a][7:0]   <= din_a[7:0];
        if (we_a[1]) ram[addr_a][15:8]  <= din_a[15:8];
        if (we_a[2]) ram[addr_a][23:16] <= din_a[23:16];
        if (we_a[3]) ram[addr_a][31:24] <= din_a[31:24];
        
        // Luôn c?p nh?t d? li?u ??c ra cho C?ng A
        dout_a <= ram[addr_a];
    end

    // Logic x? lý cho C?ng B (Ho?t ??ng song song và ??c l?p v?i C?ng A)
    always @(posedge clk) begin
        if (we_b[0]) ram[addr_b][7:0]   <= din_b[7:0];
        if (we_b[1]) ram[addr_b][15:8]  <= din_b[15:8];
        if (we_b[2]) ram[addr_b][23:16] <= din_b[23:16];
        if (we_b[3]) ram[addr_b][31:24] <= din_b[31:24];
        
        // Luôn c?p nh?t d? li?u ??c ra cho C?ng B
        dout_b <= ram[addr_b];
    end
endmodule